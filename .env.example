# Copy to .env and fill in. NEVER commit .env.

# --- Data ---
# Leave blank to use the first CSV found in data/raw/
RAW_CSV=
# Optional: keep only steps <= MAX_STEP (keeps fraud prevalence; shrinks the data for small Azure budgets)
MAX_STEP=
# Salt used to hash account IDs (any random string)
HASH_SALT=change-me

# --- Cost model used to pick the alert threshold ---
# A missed fraud costs its transaction amount; every alert costs REVIEW_COST to investigate.
REVIEW_COST=10

# --- Database (choose ONE) ---
# 1) Azure SQL (recommended for the real run)
AZURE_SQL_SERVER=yourserver.database.windows.net
AZURE_SQL_DATABASE=frpdb
AZURE_SQL_USER=frpadmin
AZURE_SQL_PASSWORD=
# 2) Any SQLAlchemy URL (overrides the above)
DATABASE_URL=
# If neither is set, a local SQLite file (data/frp_local.db) is used.

# "replace" lets pandas create tables; "append" loads into tables created by sql/schema.sql
LOAD_MODE=replace
# "all" or "test_period" (only load transactions from the test period, to save Azure space)
LOAD_SCOPE=all

# --- Azure Storage (optional upload of raw/curated/gold files) ---
AZURE_STORAGE_CONNECTION_STRING=
